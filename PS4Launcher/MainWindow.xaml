<Window x:Class="PS4Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS4 Launcher"
        Height="900"
        Width="1600"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#0a0d12">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#111820"
                Padding="18"
                BorderBrush="#1d2835"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="PS4"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#dfe7ff"/>
                    <TextBlock Text="APP LAUNCHER"
                               FontSize="22"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#9bb0d0"/>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Height="42"
                         FontSize="18"
                         Margin="20,0,0,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="AppPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="30"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="200"
                                Height="200"
                                Margin="18"
                                Click="LaunchApp_Click"
                                Tag="{Binding Path}"
                                Background="#181d26"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="14">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="28"
                                                        BorderBrush="#2d3744"
                                                        BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root"
                                                                Property="Background"
                                                                Value="#202a38"/>
                                                    </Trigger>

                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Root"
                                                                Property="Background"
                                                                Value="#141b25"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                            <StackPanel>
                                <Border Width="72"
                                        Height="72"
                                        CornerRadius="18"
                                        Background="#0d1217"
                                        Margin="0,0,0,10">
                                    <Image Source="{Binding Icon}"
                                           Width="52"
                                           Height="52"
                                           Stretch="Uniform"/>
                                </Border>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Width="150"
                                           Foreground="#eef4ff"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
