<Window x:Class="PS4Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS4 Launcher"
        Height="900"
        Width="1600"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#0a0d12"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#111820"
                Padding="18"
                BorderBrush="#1d2835"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="PS4"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#dfe7ff"/>
                    <TextBlock Text="HOME"
                               FontSize="20"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#8ea2c0"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Height="42"
                         FontSize="18"
                         Margin="20,0,0,0"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30,20,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Margin="12,0,0,12">
                <TextBlock Text="APPLICATIONS"
                           Foreground="#e8edf7"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="  •  PLAYSTATION STYLE LAUNCHER"
                           Foreground="#8599ba"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="10,8,0,0"/>
            </StackPanel>

            <ListBox x:Name="AppList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="AppList_MouseDoubleClick"
                     SelectionChanged="AppList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="18"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            CornerRadius="28"
                                            BorderThickness="2"
                                            BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root"
                                                    Property="Background"
                                                    Value="#1b2d46"/>
                                            <Setter TargetName="Root"
                                                    Property="BorderBrush"
                                                    Value="#7aa7ff"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root"
                                                    Property="Background"
                                                    Value="#1c2634"/>
                                            <Setter TargetName="Root"
                                                    Property="BorderBrush"
                                                    Value="#3b4f6c"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180"
                                Height="180"
                                CornerRadius="28"
                                Background="#171f2d"
                                BorderBrush="#2b3746"
                                BorderThickness="1"
                                Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Width="72"
                                        Height="72"
                                        CornerRadius="18"
                                        Background="#0d1218"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0">
                                    <Image Source="{Binding Icon}"
                                           Width="54"
                                           Height="54"
                                           Stretch="Uniform"/>
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Name}"
                                           Foreground="#edf4ff"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
