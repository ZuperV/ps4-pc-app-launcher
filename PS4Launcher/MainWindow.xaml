<Window x:Class="PS4Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Home"
        Height="900"
        Width="1600"
        MinHeight="640"
        MinWidth="1000"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#08111f"
        Foreground="#f2f6ff"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#9aabc5"/>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#bdcbe0"/>
            <Setter Property="Background" Value="#17263a"/>
            <Setter Property="BorderBrush" Value="#2a405d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#10223b" Offset="0"/>
                <GradientStop Color="#091321" Offset="0.5"/>
                <GradientStop Color="#101a2b" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#b0091422" Padding="28,18" BorderBrush="#33445e" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PS4" FontSize="28" FontWeight="Bold" Foreground="#f4f7ff"/>
                    <TextBlock Text="  PC HOME" FontSize="16" FontWeight="SemiBold" Foreground="#9db6d9" VerticalAlignment="Center" Margin="8,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ClockText" Grid.Column="1" Foreground="#c9d6e8" FontSize="16" VerticalAlignment="Center" Margin="0,0,26,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="2" Height="40" FontSize="15" Padding="12,0" VerticalContentAlignment="Center" ToolTip="Search your apps" TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="30,22,30,18">
            <Button Content="HOME" Tag="All" Style="{StaticResource NavButtonStyle}" Click="CategoryButton_Click"/>
            <Button Content="GAMES" Tag="Games" Style="{StaticResource NavButtonStyle}" Click="CategoryButton_Click"/>
            <Button Content="APPS" Tag="Apps" Style="{StaticResource NavButtonStyle}" Click="CategoryButton_Click"/>
            <Button Content="MEDIA" Tag="Media" Style="{StaticResource NavButtonStyle}" Click="CategoryButton_Click"/>
            <Button Content="FAVORITES" Tag="Favorites" Style="{StaticResource NavButtonStyle}" Click="CategoryButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="30,0,30,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,14">
                <TextBlock x:Name="CurrentCategoryLabel" Text="WHAT'S NEW" FontSize="22" FontWeight="SemiBold" Foreground="#f2f6ff"/>
                <TextBlock x:Name="AppCountText" Text="" FontSize="14" Foreground="#9aabc5" VerticalAlignment="Center" Margin="12,5,0,0"/>
            </StackPanel>

            <ListBox x:Name="AppList" Grid.Row="1" Grid.Column="0"
                     Background="Transparent" BorderThickness="0" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="AppList_MouseDoubleClick"
                     SelectionChanged="AppList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TileFrame" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" Padding="3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TileFrame" Property="BorderBrush" Value="#e8f2ff"/>
                                            <Setter TargetName="TileFrame" Property="Background" Value="#557ca9d8"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileFrame" Property="BorderBrush" Value="#9ecbff"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="164" Height="164" CornerRadius="7" Background="#19283a" BorderBrush="#405875" BorderThickness="1">
                            <Grid ClipToBounds="True">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#253c58" Offset="0"/>
                                        <GradientStop Color="#142033" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Image Source="{Binding Icon}" Stretch="UniformToFill" Opacity="0.34"/>
                                <Border Background="#77071320"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                    <Border Width="64" Height="64" CornerRadius="14" Background="#d9152232" Padding="8" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="44"/>
                                </StackPanel>
                                <TextBlock Text="★" Visibility="{Binding IsFavorite, Converter={x:Static BooleanToVisibilityConverter.Instance}}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" Foreground="#ffd76a" FontSize="18"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="20,0,0,0" Background="#bb101b2b" CornerRadius="14" BorderBrush="#354a65" BorderThickness="1" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SELECTED" Foreground="#96abc8" FontSize="13" FontWeight="Bold"/>
                    <Border Grid.Row="1" Height="145" Margin="0,18,0,18" CornerRadius="10" Background="#1b2b40" ClipToBounds="True">
                        <Image x:Name="SelectedAppImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="SelectedAppName" Text="Choose an app" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#f2f6ff"/>
                        <TextBlock x:Name="SelectedAppCategory" Text="Select a tile to see details" FontSize="14" Foreground="#9aabc5" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SelectedAppPath" Text="" FontSize="11" Foreground="#71839c" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                        <Button Content="START" Height="46" Click="LaunchSelected_Click" Background="#dbeaff" Foreground="#14243b" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand"/>
                        <Button x:Name="FavoriteButton" Content="ADD TO FAVORITES" Height="42" Margin="0,10,0,0" Click="FavoriteSelected_Click" Background="#20334a" Foreground="#e1ebf8" BorderBrush="#405875" BorderThickness="1" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#8b07101c" Padding="30,12" BorderBrush="#26374d" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="← → ↑ ↓  Navigate     ENTER  Start     F  Favorite     ESC  Exit" Foreground="#9aabc5" FontSize="13" DockPanel.Dock="Left"/>
                <TextBlock Text="PC APP LAUNCHER" Foreground="#71839c" FontSize="12" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
